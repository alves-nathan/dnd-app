{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "types": [
      "jest",
      "react",
      "node"
    ],
    "moduleResolution": "bundler"
  },
  "include": [
    "app",
    "src"
  ]
}
